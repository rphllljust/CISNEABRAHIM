{
  "name": "@cisne/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.spec.ts' --exclude '**/*.e2e.spec.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:perf:smoke": "vitest run --config vitest.perf.config.ts src/performance/performance-smoke.perf-smoke.spec.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:backup": "vitest run src/ops/backup",
    "backup:run": "npx tsx src/ops/backup/cli/run-backup.ts",
    "test:dr": "vitest run src/ops/dr",
    "dr:drill": "npx tsx src/ops/dr/cli/run-dr-drill.ts",
    "test:hml": "vitest run src/ops/hml",
    "hml:smoke": "npx tsx src/ops/hml/cli/run-hml-smoke.ts",
    "hml:deploy": "npx tsx src/ops/hml/cli/run-hml-deploy.ts",
    "test:cd": "vitest run src/ops/cd",
    "cd:promote": "npx tsx src/ops/cd/cli/run-cd-promote.ts",
    "test:prod": "vitest run src/ops/prod",
    "prod:validate": "npx tsx src/ops/prod/cli/run-prod-validate.ts",
    "test:uat:unit": "vitest run src/uat --exclude '**/*.integration.spec.ts'",
    "test:uat": "vitest run --config vitest.integration.config.ts src/uat/uat-business.integration.spec.ts"
  },
  "dependencies": {
    "@cisne/database": "workspace:*",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "^11.1.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-fastify": "^11.1.2",
    "pdfkit": "^0.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cisne/eslint-config": "workspace:*",
    "@cisne/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.2",
    "@swc/core": "^1.11.29",
    "@types/node": "^22.15.29",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^3.2.1",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "fastify": "^5.3.3",
    "pg": "^8.16.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.1"
  }
}
