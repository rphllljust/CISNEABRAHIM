# Neutral editor defaults. No primary language has been selected.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{js,cjs,mjs,ts,tsx,jsx,css,scss,html,xml}]
indent_style = space
indent_size = 2

[*.{py}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
