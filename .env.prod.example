# CISNE Rondônia — Produção (referência endurecida)
# Copiar para .env.prod (nunca commitar). Provisionar secrets via secret manager em cloud real.
# Uso local endurecido: cp .env.prod.example .env.prod && docker compose -f docker/prod/compose.yaml --env-file .env.prod up -d --build

CISNE_ENV=production
NODE_ENV=production

# URLs públicas (HTTPS obrigatório)
PROD_PUBLIC_API_URL=https://api.cisne.example
PROD_PUBLIC_WEB_URL=https://app.cisne.example
PUBLIC_API_URL=https://api.cisne.example
PUBLIC_WEB_URL=https://app.cisne.example
CORS_ORIGIN=https://app.cisne.example
PORT=3000
API_HOST=0.0.0.0

# Edge — somente 80/443 expostos via Caddy
PROD_EXPOSED_PORTS=80,443
PROD_DOMAIN=api.cisne.example
PROD_WEB_DOMAIN=app.cisne.example

# PostgreSQL — rede restrita, TLS, storage durável
PROD_POSTGRES_USER=cisne_prod
PROD_POSTGRES_PASSWORD=change_me_use_secret_manager
PROD_POSTGRES_DB=cisne_production
DATABASE_URL=postgresql://cisne_prod:change_me_use_secret_manager@postgres:5432/cisne_production?sslmode=require
PGSSLMODE=require
DATABASE_POOL_MAX=10
PROD_POSTGRES_STORAGE_GB=20
PROD_REQUIRE_DB_TLS=true

# Object storage — privado, versionado, lifecycle gerenciado
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=cisne-prod-documents
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_VERSIONING=true
OBJECT_STORAGE_LIFECYCLE_CONFIGURED=true
OBJECT_STORAGE_IAM_ROLE=true
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me_use_secret_manager

# Secrets — preferir *_FILE montados pelo secret manager
PROD_REQUIRE_SECRET_STORE=false
JWT_SECRET=production-jwt-secret-with-at-least-32-characters-change-me
JWT_ISSUER=cisne-api
JWT_AUDIENCE=cisne-clients
DOCUMENT_DOWNLOAD_TOKEN_SECRET=production-document-token-secret-change-me

# Service accounts / IAM
BACKUP_USE_DEDICATED_ROLE=true
PROD_CLOUD_ADMIN_CREDENTIALS=false

# Scaling baseline (Prompt 82)
PROD_API_REPLICAS=1

# Cost controls
PROD_COST_ALERTS_ENABLED=true
PROD_MONTHLY_BUDGET_USD=500

# Backup (Prompt 84)
BACKUP_ENABLE_POSTGRES=true
BACKUP_ENABLE_OBJECT_STORAGE=true
BACKUP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BACKUP_STATUS_FILE=.backup/prod/status/latest.json

# TLS
PROD_REQUIRE_TLS=true

# Outbox worker (multi-instance safe via DB locking)
OUTBOX_PUBLISHER_ENABLED=true

# Integrações — configurar sandbox/produção conforme política empresarial
EMAIL_NOTIFICATION_CONFIGURED=false
WHATSAPP_NOTIFICATION_CONFIGURED=false
