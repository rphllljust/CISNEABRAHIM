# CISNE Web — static artifact from the same monorepo build
FROM node:24-alpine AS builder
ARG VITE_API_BASE_URL=http://localhost:3100
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_FEATURE_MODULE_FINANCE=false
ARG VITE_FEATURE_MODULE_FISCAL=false
ARG VITE_FEATURE_MODULE_ACCOUNTING=false
ARG VITE_FEATURE_MODULE_INVENTORY=false
ARG VITE_FEATURE_MODULE_PAYROLL=false
ARG VITE_FEATURE_MODULE_PROCUREMENT=false
ARG VITE_FEATURE_MODULE_SUPPLIERS=false
ARG VITE_FEATURE_MODULE_CONTRACTS=false
ARG VITE_FEATURE_MODULE_PEOPLE=false
ARG VITE_FEATURE_MODULE_RENTALS=false
ARG VITE_FEATURE_MODULE_TRANSPORT=false
ARG VITE_FEATURE_MODULE_ALERTS=false
ARG VITE_FEATURE_MODULE_REPORTS=false
ARG VITE_FEATURE_MODULE_APPROVAL_MATRIX=false
ARG VITE_FEATURE_MODULE_OPERATIONAL_PROFITABILITY=false
ENV VITE_FEATURE_MODULE_FINANCE=$VITE_FEATURE_MODULE_FINANCE
ENV VITE_FEATURE_MODULE_FISCAL=$VITE_FEATURE_MODULE_FISCAL
ENV VITE_FEATURE_MODULE_ACCOUNTING=$VITE_FEATURE_MODULE_ACCOUNTING
ENV VITE_FEATURE_MODULE_INVENTORY=$VITE_FEATURE_MODULE_INVENTORY
ENV VITE_FEATURE_MODULE_PAYROLL=$VITE_FEATURE_MODULE_PAYROLL
ENV VITE_FEATURE_MODULE_PROCUREMENT=$VITE_FEATURE_MODULE_PROCUREMENT
ENV VITE_FEATURE_MODULE_SUPPLIERS=$VITE_FEATURE_MODULE_SUPPLIERS
ENV VITE_FEATURE_MODULE_CONTRACTS=$VITE_FEATURE_MODULE_CONTRACTS
ENV VITE_FEATURE_MODULE_PEOPLE=$VITE_FEATURE_MODULE_PEOPLE
ENV VITE_FEATURE_MODULE_RENTALS=$VITE_FEATURE_MODULE_RENTALS
ENV VITE_FEATURE_MODULE_TRANSPORT=$VITE_FEATURE_MODULE_TRANSPORT
ENV VITE_FEATURE_MODULE_ALERTS=$VITE_FEATURE_MODULE_ALERTS
ENV VITE_FEATURE_MODULE_REPORTS=$VITE_FEATURE_MODULE_REPORTS
ENV VITE_FEATURE_MODULE_APPROVAL_MATRIX=$VITE_FEATURE_MODULE_APPROVAL_MATRIX
ENV VITE_FEATURE_MODULE_OPERATIONAL_PROFITABILITY=$VITE_FEATURE_MODULE_OPERATIONAL_PROFITABILITY
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cisne/web build

FROM nginx:1.27-alpine AS runner
COPY docker/hml/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
