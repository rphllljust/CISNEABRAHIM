# CISNE — env do sandbox hermético de gates (dados sintéticos; nunca produção)
CISNE_ENV=hml
NODE_ENV=production

GATE_POSTGRES_USER=cisne_gate
GATE_POSTGRES_PASSWORD=cisne_gate_password_synthetic_change_me
GATE_POSTGRES_DB=cisne_gate

# Secrets sintéticos (gerar novos por run; nunca reutilizar produção)
GATE_JWT_SECRET=gate-jwt-secret-with-at-least-32-characters-synthetic-0001
GATE_DOCUMENT_TOKEN_SECRET=gate-document-token-secret-synthetic-0001

# Portas publicadas do sandbox (devem estar livres)
GATE_API_PORT=3110
GATE_WEB_PORT=5184

# Bootstrap (primeira identidade — DB vazio)
BOOTSTRAP_ADMIN_LOGIN=gate-admin@cisne.invalid
BOOTSTRAP_ADMIN_PASSWORD=Gate-Synthetic-Admin-Password-0001!
BOOTSTRAP_CONFIRM=I_UNDERSTAND
