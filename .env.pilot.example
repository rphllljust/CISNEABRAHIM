# CISNE — Piloto controlado
# Copiar para .env.pilot (nunca commitar)

CISNE_ENV=pilot
NODE_ENV=production
PILOT_PROGRAM_ENABLED=true

# Escopo limitado (não migrar operação inteira)
PILOT_MAX_USERS=5
PILOT_MAX_ACTIVE_SERVICE_ORDERS=10
PILOT_VOLUME_CAP_PER_WEEK=15
PILOT_ALLOWED_ARCHETYPES=RENTAL,TRANSPORT,CIVIL_WORK
PILOT_ALLOWED_UNIT_IDS=unit-pilot-a

# Janela mínima de observação antes de encerrar piloto
PILOT_STARTED_AT=2026-08-30T00:00:00.000Z
PILOT_MIN_OBSERVATION_DAYS=14

# Thresholds de saída
PILOT_MAX_HTTP_ERROR_RATE=0.02
PILOT_MAX_HTTP_LATENCY_P95_MS=2000

# Feedback operacional (bugs separados de UX/feature/regra)
PILOT_FEEDBACK_FILE=.pilot/feedback.json

# Feature flags mínimas — somente com infra real
PILOT_INFRA_EXTENDED=false
# PILOT_FLAG_EXTENDED_SERVICES=true
# PILOT_FLAG_EXTERNAL_INTEGRATIONS=true

# Métricas para CLI status (opcional — normalmente coletadas de observability)
# PILOT_HTTP_REQUESTS=
# PILOT_HTTP_ERRORS=
# PILOT_HTTP_LATENCY_P95_MS=
# PILOT_DB_QUERIES=
# PILOT_DB_ERRORS=
# PILOT_DB_POOL_WAITING=
# PILOT_WORKER_PENDING=
# PILOT_OUTBOX_FAILED=
# PILOT_OS_OVERDUE=
# PILOT_BILLING_AGING=
# PILOT_SUPPORT_OPEN=
