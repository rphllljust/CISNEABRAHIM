# CISNE — Production readiness gate
# Copiar para .env.readiness (nunca commitar)

# Fonte autorizada (versionada):
# docs/19-operations/readiness-evidence.json
#
# Env vars abaixo são DERIVADAS de evidência já registrada.
# Definir flags sem atualizar readiness-evidence.json viola governança.

# Gate flags — somente após resolução REAL registrada em readiness-evidence.json
# READINESS_BUSINESS_SIGN_OFF=APPROVED
# READINESS_RPO_RTO_APPROVED=true
# UAT_MANUAL_UX_COMPLETED=true

# Release binding (opcional — sobrescreve deploy-manifest.json)
# READINESS_RELEASE_COMMIT_SHA=
# READINESS_ARTIFACT_DIGEST=
# READINESS_EVIDENCE_FILE=

# Suporte (definir antes do GO)
# PROD_TECHNICAL_OWNER_ROLE=
# PROD_INCIDENT_CHANNEL=
# PROD_ROLLBACK_AUTHORITY=
# PROD_ESCALATION_PATH=

# Piloto (herda .env.pilot quando presente)
# PILOT_PROGRAM_ENABLED=true
# PILOT_STARTED_AT=
# PILOT_MIN_OBSERVATION_DAYS=14
