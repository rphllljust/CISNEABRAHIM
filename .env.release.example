# CISNE — Release rollback drill
# Copiar para .env.release (nunca commitar)

CISNE_ENV=production
NODE_ENV=production

# Ambiente do drill (production | hml)
RELEASE_DRILL_ENVIRONMENT=production

# Manifest base (versão N) — normalmente do histórico CD
RELEASE_BASE_COMMIT_SHA=release-n
RELEASE_BASE_BUILD_RUN_ID=base

# Candidato (versão N+1) — normalmente do CI/CD atual
# RELEASE_CANDIDATE_COMMIT_SHA=
# RELEASE_CANDIDATE_BUILD_RUN_ID=

# Critérios objetivos de rollback
RELEASE_MAX_HTTP_ERROR_RATE=0.05
RELEASE_REQUIRE_HEALTH_OK=true
RELEASE_MAX_CRITICAL_BUSINESS_FAILURES=0

# Compatibilidade para mudanças incompatíveis (quando aplicável)
# RELEASE_DUAL_READ_WRITE_ENABLED=true
# RELEASE_ROLLBACK_FEATURE_FLAG=billing-v2
# RELEASE_DATA_MIGRATION_COMPLETED=true
